{
  "name": "nullpoint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-server/index.cjs --external:bufferutil --external:utf-8-validate",
    "start": "node dist-server/index.cjs",
    "dev:server": "npm run build:server && node dist-server/index.cjs"
  },
  "dependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "esbuild": "^0.28.2",
    "mpg123-decoder": "^1.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
